rules_version = '2';
// Reglas de la agencia. El correo del dueño se pone al compilar (scripts/preparar.mjs) desde src/cliente.json.
// Dueño: todo. Vendedores: salidas y reservas, sin costos. Guías: ven las salidas y marcan quién subió.
// Público: ve las salidas publicadas, reserva por enlace y ve su propia reserva con su código.
service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() { return request.auth != null; }
    function esAdmin() {
      return conSesion() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == '__CORREO_ADMIN__';
    }
    function rutaUsuario() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function perfil() { return get(rutaUsuario()).data; }
    function activo() { return conSesion() && exists(rutaUsuario()) && perfil().get('activo', true) == true; }
    function esVendedor() { return activo() && perfil().rol == 'vendedor'; }
    function esGuia() { return activo() && perfil().rol == 'guia'; }
    function esEquipo() { return esAdmin() || esVendedor() || esGuia(); }
    function rutaSalida(id) { return /databases/$(database)/documents/salidas/$(id); }
    function rutaReserva(id) { return /databases/$(database)/documents/reservas/$(id); }

    // Datos de la agencia: salen en los enlaces de los clientes (nombre, teléfono, datos de pago, política).
    match /ajustes/general {
      allow get: if true;
      allow list: if esEquipo();
      allow write: if esAdmin();
    }

    match /tours/{id} {
      allow read: if esEquipo();
      allow write: if esAdmin();
    }

    // Fotos grandes: se abren sin sesión (el cliente las ve en la salida) pero no se listan.
    match /fotos/{id} {
      allow get: if true;
      allow list: if esEquipo();
      allow write: if esAdmin();
    }

    // Costos de cada salida (bus, guía, comida, entradas): solo el dueño.
    match /costos/{id} {
      allow read, write: if esAdmin();
    }

    match /salidas/{id} {
      allow get: if true;
      // Sin sesión solo se listan las publicadas (la consulta debe pedir publica == true).
      allow list: if esEquipo() || resource.data.publica == true;
      allow create, delete: if esAdmin();
      allow update: if esAdmin()
        || (esVendedor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ocupados', 'ultimaReserva']))
        // Reserva desde el enlace: solo sube "ocupados" en lo que pide esa reserva nueva, sin pasarse del cupo.
        || (resource.data.estado == 'abierta' && resource.data.publica == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ocupados', 'ultimaReserva'])
            && request.resource.data.ultimaReserva is string
            && !exists(rutaReserva(request.resource.data.ultimaReserva))
            && getAfter(rutaReserva(request.resource.data.ultimaReserva)).data.salidaId == id
            && request.resource.data.ocupados == resource.data.ocupados + getAfter(rutaReserva(request.resource.data.ultimaReserva)).data.personas
            && request.resource.data.ocupados <= resource.data.cupo);
    }

    // El id de la reserva es un código largo al azar: sirve de enlace para el cliente.
    match /reservas/{codigo} {
      allow get: if true;
      allow list: if esEquipo();
      allow create: if esAdmin() || esVendedor() || nuevaDelPublico();
      allow update: if esAdmin() || esVendedor()
        || (esGuia() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abordo']));
      allow delete: if esAdmin();

      function nuevaDelPublico() {
        let r = request.resource.data;
        let antes = get(rutaSalida(r.salidaId)).data;
        let despues = getAfter(rutaSalida(r.salidaId)).data;
        return codigo.size() == 20
          && r.keys().hasOnly(['salidaId', 'tourNombre', 'fecha', 'titular', 'pasajeros', 'adultos', 'ninos', 'personas', 'total', 'pagos', 'pagado', 'estado', 'origen', 'abordo', 'creada'])
          && r.origen == 'enlace' && r.estado == 'pendiente' && r.pagado == 0 && r.pagos.size() == 0 && r.abordo.size() == 0
          && r.adultos is int && r.ninos is int && r.adultos >= 0 && r.ninos >= 0
          && r.personas == r.adultos + r.ninos && r.personas >= 1 && r.personas <= 20
          && r.pasajeros is list && r.pasajeros.size() == r.personas
          && r.titular.nombre is string && r.titular.nombre.size() > 0 && r.titular.nombre.size() <= 120
          && r.titular.telefono is string && r.titular.telefono.size() <= 30
          && antes.estado == 'abierta' && antes.publica == true
          && despues.ultimaReserva == codigo && despues.ocupados == antes.ocupados + r.personas
          && r.total == r.adultos * antes.precioAdulto + r.ninos * antes.precioNino
          && r.fecha == antes.fecha && r.creada == request.time;
      }
    }

    // Invitaciones para vendedores y guías: el código es el id del documento. Solo se puede usar una vez.
    match /invitaciones/{codigo} {
      allow get: if conSesion();
      allow list, create, delete: if esAdmin();
      allow update: if esAdmin()
        || (conSesion() && resource.data.usada == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usada', 'uid'])
            && request.resource.data.usada == true && request.resource.data.uid == request.auth.uid
            && getAfter(rutaUsuario()).data.codigo == codigo);
    }

    match /usuarios/{uid} {
      allow read: if esAdmin() || esEquipo() || (conSesion() && request.auth.uid == uid);
      allow create: if conSesion() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rol', 'codigo', 'nombre', 'correo', 'telefono', 'activo'])
        && request.resource.data.activo == true
        && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigo)).data.usada == false
        && request.resource.data.rol == get(/databases/$(database)/documents/invitaciones/$(request.resource.data.codigo)).data.get('rol', 'vendedor')
        && request.resource.data.rol in ['vendedor', 'guia'];
      allow update, delete: if esAdmin();
    }
  }
}
